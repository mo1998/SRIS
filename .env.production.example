# Smart Remote Interview System - Production Environment Template
# Copy to .env on the production host and replace every CHANGE_ME value:
#   cp .env.production.example .env
# ./deploy.sh production refuses to run until all CHANGE_ME values are replaced.

# ===========================================
# Application Settings
# ===========================================
DEBUG=False
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
DOMAIN=sris.example.com
FRONTEND_URL=https://sris.example.com
ALLOWED_ORIGINS=["https://sris.example.com"]

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# ===========================================
# Redis Cache
# ===========================================
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ===========================================
# OpenAI API (legacy fallback; optional)
# ===========================================
OPENAI_API_KEY=

# ===========================================
# Email (Resend in production)
# ===========================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=CHANGE_ME_resend_api_key
MAIL_FROM=interviews@example.com
MAIL_FROM_NAME=SRIS
INVITATION_RESEND_COOLDOWN_SECONDS=300
MAX_BULK_INVITATIONS=100

# ===========================================
# AI Evaluation (hybrid: local vLLM -> cloud -> deterministic)
# ENABLE_LOCAL_LLM=true requires an NVIDIA GPU on the host and starts the
# local-model service via the 'local-llm' compose profile (deploy.sh handles it).
# LOCAL_LLM_ENABLED/CLOUD_LLM_ENABLED decide which endpoints the provider
# chain attempts; a disabled or unreachable endpoint falls through.
# ===========================================
EVALUATION_PROVIDER=hybrid
EVALUATION_QUEUE_BACKEND=rq
EVALUATION_QUEUE_NAME=evaluation
EVALUATION_PROMPT_VERSION=rubric-v1
ENABLE_LOCAL_LLM=false
LOCAL_LLM_ENABLED=false
LOCAL_MODEL_IMAGE=vllm/vllm-openai:latest
LOCAL_MODEL_PATH=./models/qwen3-8b-awq
LOCAL_MODEL_SERVED_NAME=qwen3-8b-awq
LOCAL_MODEL_MAX_MODEL_LEN=4096
LOCAL_MODEL_GPU_MEMORY_UTILIZATION=0.50
LOCAL_MODEL_MAX_NUM_SEQS=8
CUDA_VISIBLE_DEVICES=0
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
LOCAL_LLM_BASE_URL=http://local-model:8100/v1
LOCAL_LLM_MODEL=qwen3-8b-awq
LOCAL_LLM_TIMEOUT_SECONDS=5
CLOUD_LLM_ENABLED=true
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_API_KEY=CHANGE_ME_cloud_llm_api_key
CLOUD_LLM_TIMEOUT_SECONDS=20

# ===========================================
# Port Mappings
# ===========================================
BACKEND_PORT=8000
FRONTEND_PORT=80
MAX_REQUEST_BODY_SIZE=20971520

# ===========================================
# SSL/TLS (Let's Encrypt via certbot compose service)
# ===========================================
LETSENCRYPT_EMAIL=CHANGE_ME_admin@example.com
SSL_CERTIFICATE=/etc/letsencrypt/live/sris.example.com/fullchain.pem
SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/sris.example.com/privkey.pem
