# Smart Remote Interview System - Production Environment Template
# Copy to .env on the production host and replace every CHANGE_ME value:
#   cp .env.production.example .env
# ./deploy.sh production refuses to run until all CHANGE_ME values are replaced.

# ===========================================
# Application Settings
# ===========================================
DEBUG=False
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
DOMAIN=sris.example.com
FRONTEND_URL=https://sris.example.com
ALLOWED_ORIGINS=["https://sris.example.com"]

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# ===========================================
# Redis Cache
# ===========================================
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ===========================================
# OpenAI API (legacy fallback; optional)
# ===========================================
OPENAI_API_KEY=

# ===========================================
# Email (Resend in production)
# ===========================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=CHANGE_ME_resend_api_key
MAIL_FROM=interviews@example.com
MAIL_FROM_NAME=SRIS
INVITATION_RESEND_COOLDOWN_SECONDS=300
MAX_BULK_INVITATIONS=100

# ===========================================
# Anti-Cheating / Integrity
# ===========================================
INTEGRITY_TRACKING_ENABLED=true
INTEGRITY_BLOCK_CLIPBOARD=true
INTEGRITY_ENFORCE_FULLSCREEN=true

# ===========================================
# AI Evaluation (configured per organization from the employer dashboard)
# LLM endpoints (base URL, model, API key) are set per org in the UI, so no
# provider env vars are needed. ENABLE_LOCAL_LLM=true starts the local-model
# service via the 'local-llm' compose profile (deploy.sh handles it) so orgs
# can point their local_vllm provider at http://local-model:8100/v1.
# ===========================================
EVALUATION_QUEUE_BACKEND=rq
EVALUATION_QUEUE_NAME=evaluation
EVALUATION_PROMPT_VERSION=rubric-v2
EVALUATION_MAX_TOKENS=512
EVALUATION_STRUCTURED_OUTPUT_ENABLED=true
ENABLE_LOCAL_LLM=false
LOCAL_MODEL_IMAGE=vllm/vllm-openai:latest
LOCAL_MODEL_PATH=./models/qwen3-8b-awq
LOCAL_MODEL_SERVED_NAME=qwen3-8b-awq
LOCAL_MODEL_MAX_MODEL_LEN=4096
LOCAL_MODEL_GPU_MEMORY_UTILIZATION=0.50
LOCAL_MODEL_MAX_NUM_SEQS=8
CUDA_VISIBLE_DEVICES=0
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ===========================================
# Port Mappings
# ===========================================
BACKEND_PORT=8000
FRONTEND_PORT=80
MAX_REQUEST_BODY_SIZE=20971520

# ===========================================
# SSL/TLS (Let's Encrypt via certbot compose service)
# ===========================================
LETSENCRYPT_EMAIL=CHANGE_ME_admin@example.com
SSL_CERTIFICATE=/etc/letsencrypt/live/sris.example.com/fullchain.pem
SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/sris.example.com/privkey.pem

# ===========================================
# Observability (Prometheus + Grafana + Loki)
# Grafana binds to 127.0.0.1 by default; reach it via an SSH tunnel:
#   ssh -L 3000:127.0.0.1:3000 user@host
# Set GRAFANA_BIND_ADDRESS=0.0.0.0 only if you front it with your own auth.
# SLACK_WEBHOOK_URL routes alertmanager alerts to a Slack channel. When set,
# deploy.sh also starts the alertmanager service; leave empty to skip Slack
# alert delivery entirely.
# ===========================================
ENABLE_OBSERVABILITY=true
PROMETHEUS_RETENTION_DAYS=30
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
GRAFANA_ROOT_URL=
SLACK_WEBHOOK_URL=
