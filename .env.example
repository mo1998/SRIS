# Smart Remote Interview System - Environment Template
# Copy to .env and customize for your setup.
#
# docker-compose overrides Docker-internal URLs (DB, Redis, Mailpit)
# automatically. Leave those vars unset unless running natively.

# ===========================================
# Application Settings
# ===========================================
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-key-at-least-32-chars
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8001"]

# ===========================================
# Anti-Cheating / Integrity
# ===========================================
INTEGRITY_TRACKING_ENABLED=true
INTEGRITY_BLOCK_CLIPBOARD=true
INTEGRITY_ENFORCE_FULLSCREEN=false

# ===========================================
# PostgreSQL (host-local ports for native dev)
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# DATABASE_URL is auto-set in Docker; set here only for native dev:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sris_db

# ===========================================
# Redis (host-local ports for native dev)
# ===========================================
REDIS_PASSWORD=redispassword
REDIS_PORT=6379
# REDIS_URL is auto-set in Docker; set here only for native dev:
# REDIS_URL=redis://:redispassword@localhost:6379

# ===========================================
# Port Mappings (docker-compose host ports)
# ===========================================
BACKEND_PORT=8001
FRONTEND_PORT=80

# ===========================================
# AI Evaluation
# ===========================================
# LLM endpoints (base URL, model, API key) are configured per organization from
# the employer dashboard (Dashboard -> AI Provider); no env vars required here.
# Use 'background' for native dev, 'rq' for Docker
EVALUATION_QUEUE_BACKEND=background
EVALUATION_QUEUE_NAME=evaluation
EVALUATION_PROMPT_VERSION=rubric-v2
EVALUATION_MAX_TOKENS=512
EVALUATION_STRUCTURED_OUTPUT_ENABLED=true
EVALUATION_PII_MASKING_ENABLED=true

# Langfuse tracing (self-hosted OSS; disable unless you run the observability profile)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-sris
LANGFUSE_SECRET_KEY=sk-sris
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LOCAL_MODEL_IMAGE=vllm/vllm-openai:latest
LOCAL_MODEL_PATH=./models/qwen3-8b-awq
LOCAL_MODEL_PORT=8100
LOCAL_MODEL_SERVED_NAME=qwen3-8b-awq
LOCAL_MODEL_MAX_MODEL_LEN=4096
LOCAL_MODEL_GPU_MEMORY_UTILIZATION=0.50
LOCAL_MODEL_MAX_NUM_SEQS=8
CUDA_VISIBLE_DEVICES=0
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ===========================================
# OpenAI API (fallback)
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here

# ===========================================
# Email (Mailpit for development)
# ===========================================
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=SRIS
MAILPIT_API_URL=http://localhost:8025/api/v1/send
INVITATION_RESEND_COOLDOWN_SECONDS=300
MAX_BULK_INVITATIONS=100
MAX_REQUEST_BODY_SIZE=20971520

# ===========================================
# SSL/TLS (production only, uncomment to use)
# ===========================================
# SSL_CERTIFICATE=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/yourdomain.com/privkey.pem
